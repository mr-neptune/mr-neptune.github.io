{
  "$schema": "https://unpkg.com/wrangler@4.159.0/config-schema.json",
  "name": "wayne-skyline",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "wayne-wen.dev", "custom_domain": true },
    { "pattern": "www.wayne-wen.dev", "custom_domain": true }
  ],
  // Noise to Music lives in the lab submodule (github.com/mr-neptune/noise-to-music).
  // Copy its web/ folder to /lab/ before every deploy or dev run.
  "build": {
    "command": "test -f lab/web/index.html || git submodule update --init lab; rm -rf public/lab && cp -R lab/web public/lab",
    "watch_dir": "lab/web"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://wayne-wen.dev",
    "CANONICAL_HOST": "wayne-wen.dev"
  },
  "durable_objects": {
    "bindings": [{ "name": "SKYLINE", "class_name": "Skyline" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Skyline"] }],
  "observability": { "enabled": true }
}
