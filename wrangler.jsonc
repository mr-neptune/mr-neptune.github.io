{
  "$schema": "https://unpkg.com/wrangler@4.159.0/config-schema.json",
  "name": "wayne-skyline",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "wayne-wen.dev", "custom_domain": true },
    { "pattern": "www.wayne-wen.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://wayne-wen.dev",
    "CANONICAL_HOST": "wayne-wen.dev"
  },
  "durable_objects": {
    "bindings": [{ "name": "SKYLINE", "class_name": "Skyline" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Skyline"] }],
  "observability": { "enabled": true }
}
